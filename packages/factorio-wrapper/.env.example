# Absolute path to the Factorio executable
FACTORIO_PATH='C:/Program Files (x86)/Steam/steamapps/common/Factorio/bin/x64/factorio.exe'

# Absolute path to the target save file (.zip)
FACTORIO_SAVE_PATH='C:/Users/USERNAME/AppData/Roaming/Factorio/saves/save_name.zip'

# RCON Configuration (Must match server-settings.json)
FACTORIO_RCON_PASSWORD='your_rcon_password'
FACTORIO_RCON_PORT=27015

# WebSocket Server Configuration
WS_SERVER_PORT=8080
WS_SERVER_HOST='localhost'
